{
    "manifest_version": 3,
    "name": "React Path Inspector",
    "description": "Inspect Next.js + Turbopack apps: see the component path from root to element, read props, and open components in VS Code or Cursor.",
    "version": "0.1.17",
    "icons": {
        "16": "public/icons/icon16.png",
        "32": "public/icons/icon32.png",
        "48": "public/icons/icon48.png",
        "128": "public/icons/icon128.png"
    },
    "permissions": [
        "alarms",
        "contextMenus",
        "scripting",
        "storage",
        "tabs"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "host_permissions": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html"
}
